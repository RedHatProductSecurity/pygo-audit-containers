#!/usr/bin/env python3
"""Extract image layers, the merged rootfs, and pygo-audit image metadata."""

from __future__ import annotations

import argparse
import json
import os
import posixpath
from pathlib import Path
from pathlib import PurePosixPath
import re
import shutil
import stat
import subprocess
import sys
import tarfile
import tempfile


SCRIPT_ROOT = Path(__file__).resolve().parent
if str(SCRIPT_ROOT) not in sys.path:
    sys.path.insert(0, str(SCRIPT_ROOT))
SOURCE_ROOT = SCRIPT_ROOT.parent / "src"
if str(SOURCE_ROOT) not in sys.path:
    sys.path.insert(0, str(SOURCE_ROOT))

from container_metadata import (  # noqa: E402
    collect_product_identities,
    read_os_release,
)
from pygo_audit.storage import atomic_read_json  # noqa: E402
from pygo_audit.identity import (  # noqa: E402
    DEFAULT_METADATA_NAME,
    write_identity,
)
from pygo_audit.models import ImageIdentity  # noqa: E402


DEFAULT_PLATFORM = "linux/amd64"
PLATFORM_RE = re.compile(r"^[^/]+/[^/]+(?:/[^/]+)?$")
DIGEST_RE = re.compile(r"^[A-Za-z0-9_+.-]+:[0-9A-Fa-f]{32,}$")


class ExtractionError(Exception):
    """An expected image extraction failure."""


def required_commands() -> None:
    if sys.platform != "linux" or not Path("/proc/self/fd").is_dir():
        raise ExtractionError("image extraction requires Linux with /proc mounted")
    for command in ("skopeo", "oc", "tar"):
        if shutil.which(command) is None:
            raise ExtractionError(f"required command not found: {command}")


def parse_platform(value: str) -> tuple[str, str, str]:
    if PLATFORM_RE.fullmatch(value) is None:
        raise ExtractionError("--platform must be OS/ARCH or OS/ARCH/VARIANT")
    operating_system, architecture, *variant = value.split("/")
    return operating_system, architecture, variant[0] if variant else ""


def run_command(command: list[str], description: str) -> None:
    completed = subprocess.run(command, check=False)
    if completed.returncode != 0:
        raise ExtractionError(
            f"{description} failed with exit status {completed.returncode}; "
            "partial output has been retained"
        )


def copy_image(image: str, cache: Path, platform: str) -> None:
    operating_system, architecture, variant = parse_platform(platform)
    command = [
        "skopeo",
        "--override-os",
        operating_system,
        "--override-arch",
        architecture,
    ]
    if variant:
        command.extend(("--override-variant", variant))
    command.extend(("copy", f"docker://{image}", f"dir:{cache}"))
    print(f"Copying image: {image} ({platform})", flush=True)
    run_command(command, "skopeo image copy")


def read_manifest(cache: Path) -> dict[str, object]:
    manifest_path = cache / "manifest.json"
    if manifest_path.is_symlink() or not manifest_path.is_file():
        raise ExtractionError(
            f"image transport did not produce a manifest: {manifest_path}"
        )
    try:
        manifest = atomic_read_json(manifest_path)
    except json.JSONDecodeError as error:
        raise ExtractionError(
            f"image transport produced invalid manifest JSON: {error}"
        ) from error
    if not isinstance(manifest, dict):
        raise ExtractionError("image manifest must be a JSON object")
    return manifest


def layer_digests(manifest: dict[str, object]) -> list[str]:
    layers = manifest.get("layers")
    if not isinstance(layers, list) or not layers:
        raise ExtractionError("image manifest does not contain any layers")

    digests: list[str] = []
    for layer in layers:
        digest = layer.get("digest") if isinstance(layer, dict) else None
        if not isinstance(digest, str) or DIGEST_RE.fullmatch(digest) is None:
            raise ExtractionError(
                f"image manifest contains an invalid layer digest: {digest!r}"
            )
        digests.append(digest)
    return digests


def restrict_subject_permissions(subject: Path) -> None:
    """Make subject files owner-readable and directories owner-accessible only."""

    def fail(error: OSError) -> None:
        raise error

    root = os.open(subject, os.O_PATH | os.O_DIRECTORY | os.O_NOFOLLOW)
    try:
        os.chmod(f"/proc/self/fd/{root}", 0o700)
        for _, directories, files, directory in os.fwalk(
            ".", dir_fd=root, follow_symlinks=False, onerror=fail
        ):
            for name in (*directories, *files):
                # O_PATH pins even unreadable entries without following image links.
                descriptor = os.open(name, os.O_PATH | os.O_NOFOLLOW, dir_fd=directory)
                try:
                    mode = os.fstat(descriptor).st_mode
                    if stat.S_ISLNK(mode):
                        continue
                    if not stat.S_ISDIR(mode) and not stat.S_ISREG(mode):
                        raise ExtractionError(f"unsupported subject file: {name!r}")
                    permissions = 0o700 if stat.S_ISDIR(mode) else 0o400
                    os.chmod(f"/proc/self/fd/{descriptor}", permissions)
                finally:
                    os.close(descriptor)
    finally:
        os.close(root)


def archive_path(name: str, kind: str) -> PurePosixPath:
    """Validate a layer member path without normalizing out traversal."""
    path = PurePosixPath(name)
    if not name or "\x00" in name or path.is_absolute() or ".." in path.parts:
        raise ExtractionError(f"layer archive contains unsafe {kind} path: {name!r}")
    return path


def validate_symlink_target(member: PurePosixPath, target: str) -> None:
    """Allow symlinks only when their target stays inside the layer root."""
    if not target or "\x00" in target:
        raise ExtractionError(
            f"layer archive contains unsafe symlink target for {member}: {target!r}"
        )
    # Absolute links are normal in container images (for example, /bin/sh).
    # They are links, not extraction paths; the scanner also never follows them.
    if PurePosixPath(target).is_absolute():
        return
    resolved = PurePosixPath(
        posixpath.normpath(posixpath.join(member.parent.as_posix(), target))
    )
    if ".." in resolved.parts:
        raise ExtractionError(
            f"layer archive symlink escapes its root at {member}: {target!r}"
        )


def validate_layer_archive(blob: Path) -> None:
    """Reject archive paths and file types that could cross the extraction boundary."""
    try:
        with tarfile.open(blob, mode="r:*") as archive:
            for member in archive:
                member_path = archive_path(member.name, "member")
                if member.issym():
                    validate_symlink_target(member_path, member.linkname)
                elif member.islnk():
                    archive_path(member.linkname, "hard-link target")
                elif not member.isfile() and not member.isdir():
                    raise ExtractionError(
                        f"layer archive contains unsupported special file: {member.name!r}"
                    )
    except ExtractionError:
        raise
    except (OSError, tarfile.TarError) as error:
        raise ExtractionError(
            f"cannot inspect layer archive {blob}: {error}"
        ) from error


def unpack_layer(blob: Path, layer_directory: Path, digest: str) -> None:
    validate_layer_archive(blob)
    layer_directory.mkdir()
    print(f"Extracting layer ({digest}) into {layer_directory}", flush=True)
    run_command(
        [
            "tar",
            "--extract",
            f"--file={blob}",
            f"--directory={layer_directory}",
            "--no-same-owner",
            "--no-same-permissions",
            "--delay-directory-restore",
            "--keep-directory-symlink",
        ],
        f"tar extraction for layer {digest}",
    )
    restrict_subject_permissions(layer_directory)


def extract_rootfs(image: str, platform: str, rootfs: Path) -> None:
    print(f"Extracting merged filesystem into {rootfs}", flush=True)
    run_command(
        [
            "oc",
            "image",
            "extract",
            image,
            f"--filter-by-os={platform}",
            f"--path=/:{rootfs}",
            "--confirm",
            "--only-files",
        ],
        "merged filesystem extraction",
    )


def string_value(value: object) -> str:
    return value if isinstance(value, str) else ""


def image_digest(image: str, image_info: dict[str, object]) -> str:
    digest = string_value(image_info.get("digest"))
    if DIGEST_RE.fullmatch(digest):
        return digest
    reference_digest = image.rsplit("@", 1)[-1] if "@" in image else ""
    return reference_digest if DIGEST_RE.fullmatch(reference_digest) else ""


def collect_image_info(image: str, platform: str) -> dict[str, object]:
    command = [
        "oc",
        "image",
        "info",
        "-o",
        "json",
        "--filter-by-os",
        platform,
        image,
    ]
    completed = subprocess.run(
        command,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
        encoding="utf-8",
        check=False,
    )
    if completed.returncode != 0:
        detail = completed.stderr.strip() or "oc image info failed"
        raise ExtractionError(detail)
    try:
        image_info = json.loads(completed.stdout)
    except json.JSONDecodeError as error:
        raise ExtractionError(
            f"oc image info returned invalid JSON: {error}"
        ) from error
    if not isinstance(image_info, dict):
        raise ExtractionError(
            "oc image info returned a JSON value other than an object"
        )
    return image_info


def build_image_identity(
    image: str,
    platform: str,
    image_info: dict[str, object],
    image_name: str,
    os_release: dict[str, str] | None = None,
) -> ImageIdentity:
    config = image_info.get("config")
    config = config if isinstance(config, dict) else {}
    image_config = config.get("config")
    image_config = image_config if isinstance(image_config, dict) else {}

    raw_labels = image_config.get("Labels")
    labels = {
        key: value
        for key, value in (raw_labels.items() if isinstance(raw_labels, dict) else ())
        if isinstance(key, str) and isinstance(value, str)
    }
    raw_environment = image_config.get("Env")
    environment: dict[str, str] = {}
    if isinstance(raw_environment, list):
        for item in raw_environment:
            if isinstance(item, str) and "=" in item:
                key, value = item.split("=", 1)
                environment[key] = value

    os_release = os_release or {}
    display_name = labels.get("io.openshift.build.version-display-names", "")
    build_version = labels.get("io.openshift.build.versions", "")
    component = (
        labels.get("com.redhat.component", "")
        or display_name.removeprefix("machine-os=")
        or labels.get("com.coreos.osname", "")
    )
    component_version = (
        environment.get("SOURCE_GIT_TAG", "")
        or labels.get("org.opencontainers.image.version", "")
        or build_version.removeprefix("machine-os=")
        or os_release.get("VERSION_ID", "")
    )
    product_version = (
        labels.get("version", "")
        or environment.get("BUILD_VERSION", "")
        or environment.get("OPENSHIFT_VERSION", "")
        or os_release.get("OPENSHIFT_VERSION", "")
    )

    digest = image_digest(image, image_info)
    values = {
        "reference": image,
        "digest": digest,
        "platform": platform,
        "extractor": Path(__file__).name,
        "name": image_name,
        "vendor_image_name": labels.get("name", ""),
        "image_build_release": labels.get("release", ""),
        "component": component,
        "source_git_url": labels.get("io.openshift.build.source-location", "")
        or environment.get("SOURCE_GIT_URL", ""),
        "product_version": product_version,
        "component_version": component_version,
        "product_component": labels.get("io.openshift.maintainer.component", ""),
        "cpes": tuple(
            filter(None, [labels.get("cpe", "") or os_release.get("CPE_NAME", "")])
        ),
    }
    return ImageIdentity(**values)


def write_image_sidecar(
    image: str,
    platform: str,
    rootfs: Path,
    image_info: dict[str, object],
) -> Path:
    # Extraction owns rootfs contents; generated metadata belongs beside it.
    sidecar = rootfs.parent / DEFAULT_METADATA_NAME
    metadata = build_image_identity(
        image,
        platform,
        image_info,
        rootfs.parent.name,
        read_os_release(rootfs),
    )
    layers = sorted((rootfs.parent / "layers").glob("layer-*"))
    write_identity(sidecar, collect_product_identities(metadata, rootfs, layers))
    return sidecar


def extract_image(
    image: str,
    destination: Path,
    platform: str,
) -> None:
    destination = destination.absolute()
    if destination.exists() or destination.is_symlink():
        raise ExtractionError(
            f"destination already exists: {destination}; choose a new directory"
        )
    if not destination.parent.is_dir():
        raise ExtractionError(
            f"destination parent does not exist: {destination.parent}"
        )

    required_commands()
    parse_platform(platform)

    # Resolve once so a moving tag cannot split the layer and rootfs subjects.
    image_info = collect_image_info(image, platform)
    digest = image_digest(image, image_info)
    if not digest:
        raise ExtractionError(f"cannot resolve an image digest for: {image}")
    repository, separator, name = image.split("@", 1)[0].rpartition("/")
    resolved_image = f"{repository}{separator}{name.split(':', 1)[0]}@{digest}"

    destination.mkdir()
    destination.chmod(0o700)
    rootfs = destination / "rootfs"
    rootfs.mkdir()
    rootfs.chmod(0o700)
    layers = destination / "layers"
    layers.mkdir(mode=0o700)

    with tempfile.TemporaryDirectory(prefix="transport-", dir=destination) as temporary:
        cache = Path(temporary)
        copy_image(resolved_image, cache, platform)
        manifest = read_manifest(cache)

        digests = layer_digests(manifest)
        print(f"Unpacking {len(digests)} layers into {destination}", flush=True)
        for index, digest in enumerate(digests):
            blob = cache / digest.split(":", 1)[1]
            if blob.is_symlink() or not blob.is_file():
                raise ExtractionError(f"layer blob is missing: {blob}")
            unpack_layer(blob, layers / f"layer-{index:03d}", digest)

        layers.chmod(0o700)
        extract_rootfs(resolved_image, platform, rootfs)
        restrict_subject_permissions(rootfs)
        sidecar = write_image_sidecar(
            image,
            platform,
            rootfs,
            image_info,
        )

    print(f"Extracted all {len(digests)} layers into {destination}")
    print(f"Merged filesystem available at {rootfs}")
    print(f"Image metadata sidecar available at {sidecar}")


def make_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        description="Extract image layers, a merged rootfs, and image metadata."
    )
    parser.add_argument(
        "image", metavar="IMAGE", help="registry image reference or digest"
    )
    parser.add_argument(
        "destination",
        metavar="DESTINATION",
        type=Path,
        help="new output directory",
    )
    parser.add_argument(
        "--platform",
        default=DEFAULT_PLATFORM,
        metavar="OS/ARCH[/VARIANT]",
        help=f"image platform (default: {DEFAULT_PLATFORM})",
    )
    return parser


def main(argv: list[str] | None = None) -> int:
    args = make_parser().parse_args(argv)
    try:
        extract_image(args.image, args.destination, args.platform)
    except (ExtractionError, OSError) as error:
        print(f"{sys.argv[0]}: {error}", file=sys.stderr)
        return 1
    except KeyboardInterrupt:
        print("\nExtraction interrupted; partial output retained", file=sys.stderr)
        return 130
    return 0


if __name__ == "__main__":
    sys.exit(main())
