#!/usr/bin/env python3
"""Download Red Hat VEX documents from a newline-separated CVE list."""

from pathlib import Path
import sys

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "src"))

from pygo_audit.cve_data import DownloadSource, main as download


SOURCE = DownloadSource(
    "https://security.access.redhat.com/data/csaf/v2/vex/{year}/{cve_lower}.json",
    "csaf",
    "CSAF",
    require_csaf=True,
)


def main(argv: list[str] | None = None) -> int:
    return download(SOURCE, argv)


if __name__ == "__main__":
    raise SystemExit(main())
